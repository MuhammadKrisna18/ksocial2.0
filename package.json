{
	"name": "k-social-1.2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:pull": "drizzle-kit introspect",
		"db:seed": "tsx --tsconfig tsconfig.seed.json src/lib/infrastructure/database/seed.ts",
		"db:seed-dummy": "tsx --tsconfig tsconfig.seed.json src/lib/infrastructure/database/seedDummyUsers.ts",
		"db:clean-dummy": "tsx --tsconfig tsconfig.seed.json src/lib/infrastructure/database/cleanDummyUsers.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/cookie": "^0.6.0",
		"@types/cropperjs": "^1.1.5",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cropperjs": "^1.6.3",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"firebase": "^12.19.0",
		"firebase-admin": "^14.5.0",
		"jsonwebtoken": "^9.0.3",
		"postgres": "^3.4.9"
	}
}
